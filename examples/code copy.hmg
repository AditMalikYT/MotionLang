// ============================================================================
//  AI BECOMES SMARTER — cinematic .hmg motion graphic
//  Motion Language 1.2 • full-feature showcase • 32s @ 1920x1080 / 60fps
//
//  RUN:
//    motion ai_smarter.hmg --render --workers 8 --output output/ai_smarter.mp4
//    motion ai_smarter.hmg --studio        // Remotion preview (spacebar play)
// ============================================================================

config:
    resolution = 1920x1080
    fps = 60

// ---------------------------------------------------------------------------
// 1) PYTHON INTEROP (v1.1) — stdlib, NumPy, and local helpers.py
// ---------------------------------------------------------------------------
import math
import numpy as np
import os.path
import helpers                          // ./helpers.py next to this script

// 2) MODULE SYSTEM — reusable components from another .hmg file
import stat_badge, ticker from "hud_components.hmg"

// 3) CSS STYLESHEETS (v1.1) — joins the compositor cascade
import styles from "theme.css"

// 4) GOOGLE FONTS (v1.1) — fetched + cached, offline-safe fallback
hero_font = load_font("Space Grotesk", weight="700")
ui_font   = load_font("Inter", weight="600")
mono_font = load_font("JetBrains Mono", weight="400")
web_font  = load_font("Poppins", weight="bold", url="https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap")

// ---------------------------------------------------------------------------
// 5) PROCEDURAL MATH (v1.2) — constants evaluated at build time
// ---------------------------------------------------------------------------
W = 1920
H = 1080
CX = 960
CY = 540
DURATION = 32

CYAN    = "#00E5FF"
VIOLET  = "#7C4DFF"
MAGENTA = "#FF007F"
GOLD    = "#FFC24B"
ICE     = "#EAF6FF"
BG      = "#04060E"

DIAG = sqrt(pow(W / 2, 2) + pow(H / 2, 2))  

// ---------------------------------------------------------------------------
// 6) FUNCTIONS, CLASSES & CONTROL FLOW
// ---------------------------------------------------------------------------
fn stage_color(i):
    palette = [CYAN, VIOLET, MAGENTA, GOLD]
    return palette[i % 4]

fn ring_point(angle, radius, squash):
    return (CX + cos(angle) * radius, CY + sin(angle) * radius * squash)

class GrowthModel:
    fn capability(self, t):
        return 1.0 / (1.0 + pow(e, -1.1 * (t - 3.0)))   
    fn stage_name(self, level):
        if level > 0.75:
            return "AGI HORIZON"
        elif level > 0.40:
            return "DEEP LEARNING"
        else:
            return "NARROW AI"

model = GrowthModel()
agi_caption = model.stage_name(0.9)      
peak = model.capability(6.0)            
scene:

    // ========================================================================
    // Z=0 · BACKGROUND PLATE — vignette, drifting blurred nebulae ($t motion)
    // ========================================================================
    layer(z=0):
        render(shape("rect", width=W, height=H, color=BG), time=[0, DURATION],
               fx=[vignette(amount=0.55)])

        render(shape("ellipse", width=980, height=560, color="#0D2740"),
               pos=(430 + sin($t * 0.21) * 70, 300 + cos($t * 0.17) * 40),
               time=[0, DURATION], opacity=0.55,
               fx=[blur(radius=70), opacity(alpha=0.8), blend_mode("screen")])
        render(shape("ellipse", width=820, height=500, color="#35103F"),
               pos=(1520 + cos($t * 0.16) * 90, 780 + sin($t * 0.23) * 50),
               time=[0, DURATION], opacity=0.50,
               fx=[blur(radius=85), blend_mode("screen")])
        render(shape("ellipse", width=700, height=420, color="#062E2B"),
               pos=(960 + sin($t * 0.12) * 120, 940),
               time=[0, DURATION], opacity=0.40,
               fx=[blur(radius=90), blend_mode("add")])

        // OPTIONAL B-ROLL PLATE (v1.2 video editorial: cut/trim/speed/pos).
        // Skipped gracefully if the asset is missing — Python interop check.
        if os.path.exists("assets/broll_ai.mp4"):
            plate = video("assets/broll_ai.mp4", start=4.0, end=18.0, speed=0.75)
            render(plate.cut(start=2.0, end=12.0).trim(start=0.5, duration=7.0).speed(0.8).pos((0, 0)),
                   time=[5.2, 13], opacity=0.22,
                   fx=[adjust_color(brightness=-0.12, contrast=0.18, saturation=0.35),
                       blend_mode("screen")],
                   transition_in="crossfade(1.2)", transition_out="crossfade(0.8)")

    // OPTIONAL SCORE — audio() asset, guarded by the same interop check
    if os.path.exists("assets/score.mp3"):
        layer(z=0):
            render(audio("assets/score.mp3"), time=[0, DURATION])

    // ========================================================================
    // Z=1 · SCENE 1 — IGNITION (0–6s): grid, boot HUD, first neuron fires
    // ========================================================================
    layer(z=1):
        // receding horizon grid (squared spacing = cheap perspective)
        for i in range(12):
            gy = 660 + i * i * 3.4
            render(shape("line", x1=0, y1=gy, x2=W, y2=gy, color="#10233C", width=1),
                   time=[0, 6.5], opacity=0.65 -> 0.0, ease=linear)
        for i in range(13):
            gx = i * 160
            render(shape("line", x1=gx, y1=660, x2=CX + (gx - CX) * 3.2, y2=H, color="#0C1B30", width=1),
                   time=[0, 6.5], opacity=0.50 -> 0.0, ease=linear)

        // boot-sequence microcopy — glitch + chromatic aberration FX
        render(text("SIGNAL ACQUIRED // NEURAL LINK ONLINE", font=mono_font, size=24, color=CYAN),
               pos=(80, 70), time=[0.2, 2.6],
               fx=[glitch(intensity=0.45, seed=7), chromatic_aberration(offset=3)],
               transition_in="glitch(0.25, intensity=0.8)")
        render(text("MODEL: HM-∞  ·  PARAMS: 1.8T  ·  STATE: WAKING", font=mono_font, size=24, color="#5E7BA6"),
               pos=(80, 108), time=[0.6, 2.6], opacity=0 -> 1, ease=ease_in)

        // expanding synapse rings — repeat-loop choreography
        repeat 5 times as k:
            render(shape("circle", radius=70 + k * 62, fill="none", stroke=CYAN, stroke_width=2),
                   pos=(CX, CY), time=[0.6 + k * 0.32, 3.8 + k * 0.32],
                   scale=0.15 -> 1.0, opacity=0.85 -> 0.0, ease=ease_out)

    layer(z=6):
        // the first artificial neuron ignites (flash_in dynamic FX)
        render(shape("circle", radius=12, fill=CYAN), pos=(CX, CY), time=[0.4, 6.0],
               scale=0 -> 1.5, ease=ease_out,
               fx=[glow(color=CYAN, intensity=2.6, radius=44),
                   flash_in(duration=0.28, color="#FFFFFF")],
               transition_in="glitch(0.35, intensity=0.9)")

        // hero glyph — glow + chromatic fringe + drop shadow stack
        render(text("AI", font=hero_font, size=300, color="#FFFFFF", anchor="center"),
               pos=(CX, CY + 4), time=[1.2, 6.0],
               scale=0.62 -> 1.0, ease=ease_out,
               fx=[glow(color=CYAN, intensity=1.7, radius=34),
                   chromatic_aberration(offset=4),
                   drop_shadow(offset_x=0, offset_y=16, blur=30, color="#000000AA")],
               transition_in="glitch(0.3, intensity=0.8)", transition_out="crossfade(0.7)")

        render(text("THE SPARK OF MACHINE INTELLIGENCE", font=ui_font, size=34, color=ICE, anchor="center"),
               pos=(CX, CY + 226), time=[2.3, 6.0], opacity=0 -> 1, ease=ease_in,
               fx=[glow(color=CYAN, intensity=0.7, radius=12)],
               transition_in="slide_up(0.5)", transition_out="crossfade(0.6)")

    // ========================================================================
    // Z=2 · OPTIONAL VIDEO SHARDS — split_video() triptych (guarded)
    // ========================================================================
    if os.path.exists("assets/broll_ai.mp4"):
        layer(z=2):
            shards = split_video("assets/broll_ai.mp4", intervals=3)
            for i in range(3):
                render(shards[i], pos=(480 + i * 480, 240), scale=0.42,
                       time=[6.0 + i * 0.3, 13], opacity=0.24,
                       fx=[adjust_color(saturation=0.5), blend_mode("screen")],
                       transition_in="zoom_in(0.5)")

    // ========================================================================
    // Z=3 · SCENE 2 — NEURAL CONSTELLATION (5.2–13s)
    // numpy golden-spiral particles, per-frame $t orbits, noise shimmer
    // ========================================================================
    layer(z=3):
        N = 64
        angles = np.linspace(0, 9 * pi, N)

        // synapse web: chords fade in sequentially
        repeat 18 times as k:
            a1 = (k / 18) * tau
            a2 = a1 + 0.85 + (k % 3) * 0.75
            p1 = ring_point(a1, 180 + (k % 4) * 78, 0.58)
            p2 = ring_point(a2, 180 + ((k + 2) % 4) * 78, 0.58)
            render(shape("line", x1=p1[0], y1=p1[1], x2=p2[0], y2=p2[1], color="#1D4A66", width=1.4),
                   time=[6.2 + k * 0.11, 13], opacity=0 -> 0.65, ease=ease_in,
                   transition_in="crossfade(0.7)")

        // orbiting particles — Lissajous-style polar motion, breathing radius
        for i in range(N):
            base_r  = helpers.golden_spiral_radius(i)
            spd     = helpers.orbit_speed(i)
            ph      = angles[i]
            shimmer = sqrt(i + 1) * 3.4
            render(shape("circle", radius=2 + (i % 4), fill=stage_color(i)),
                   pos=(CX + cos(ph + $t * spd) * (base_r + sin($t * 1.7 + i) * shimmer),
                        CY + sin(ph + $t * spd) * (base_r + sin($t * 1.7 + i) * shimmer) * 0.58),
                   time=[5.6, 13], opacity=0.30 + (i % 3) * 0.22,
                   fx=[blend_mode("screen")],
                   transition_in="crossfade(1.1)")

        // reactor core — pulse transform-FX + animated light sweep
        render(shape("circle", radius=112, fill="#08182B"), pos=(CX, CY), time=[5.4, 13],
               scale=0 -> 1, ease=ease_in_out,
               fx=[glow(color=CYAN, intensity=1.9, radius=64),
                   light_sweep(progress=$t, angle=45, speed=0.9, width=0.22, color="#FFFFFF"),
                   pulse(amount=0.055, speed=1.35)])
        render(shape("ellipse", width=560, height=150, fill="none", stroke=VIOLET, stroke_width=2),
               pos=(CX, CY), time=[6.0, 13], opacity=0 -> 0.7, ease=ease_out,
               fx=[float_y(distance=10, speed=0.7), blend_mode("screen")])

    // capability chips wired with statement-form transitions (v1.2)
    layer(z=7):
        cap1 = render(text("LEARNING", class="chip", anchor="center"), pos=(CX, 906), time=[7.0, 9.0],
                      transition_in="slide_up(0.4)", transition_out="crossfade(0.4)")
        cap2 = render(text("REASONING", class="chip", anchor="center"), pos=(CX, 906), time=[9.0, 11.0])
        cap3 = render(text("CREATING", class="chip", anchor="center"), pos=(CX, 906), time=[11.0, 13.0])
        transition(from=cap1, to=cap2, type="crossfade", duration=0.5)
        transition(from=cap2, to=cap3, type="glitch", duration=0.35)

    layer(z=8):
        // heading drifts on deterministic noise(x, y, seed)
        render(text("NEURAL NETWORKS LEARN FROM RAW DATA", class="section-title", anchor="center"),
               pos=(CX + noise($t, 0, 7) * 26, 130 + noise(0, $t, 7) * 18),
               time=[6.8, 13],
               transition_in="wipe_down(0.6)", transition_out="wipe_left(0.5)")

    // ========================================================================
    // Z=4 · SCENE 3 — THE LEARNING CURVE (12.4–19.5s)
    // staggered chart, activation spark, epoch counter, wiki knowledge card
    // ========================================================================
    layer(z=4):
        // capability bars — heights computed by the Python helper module
        repeat 12 times as i:
            bh = helpers.log_growth(i)
            bx = 380 + i * 106
            render(shape("rect", width=64, height=bh, color=stage_color(i), radius=8),
                   pos=(bx, 800 - bh * 0.5), time=[13.2 + i * 0.13, 19.5],
                   scale=0.06 -> 1.0, ease=ease_out,
                   fx=[glow(color=stage_color(i), intensity=0.55, radius=10)],
                   transition_in="slide_up(0.35)")

        // logistic frontier — SVG-like path with motion blur
        render(shape("path", d="M 340 830 C 640 822, 900 760, 1150 560 S 1540 260, 1640 236",
                       color=GOLD, width=4, fill="none"),
               time=[14.4, 19.5], transition_in="wipe_right(0.9)",
               fx=[glow(color=GOLD, intensity=1.5, radius=18),
                   motion_blur(samples=8, direction=0, distance=10)])

        // activation spark: tan(clamp(sin())) = spiking-neuron waveform
        for i in range(22):
            render(shape("circle", radius=3, fill=CYAN),
                   pos=(340 + i * 62, 250 + tan(clamp(sin($t * 2.4 + i * 0.55), -0.86, 0.86)) * 64),
                   time=[13.0, 19.5], opacity=0.85,
                   fx=[blend_mode("add")])

        // epoch counter — sequential text swaps with glitch-ins
        render(text("EPOCH 001", font=mono_font, size=30, color="#5E7BA6"), pos=(340, 150), time=[13.0, 15.2])
        render(text("EPOCH 010", font=mono_font, size=30, color="#8FB0DE"), pos=(340, 150), time=[15.2, 17.4],
               transition_in="glitch(0.2, intensity=0.6)")
        render(text("EPOCH 100 — LOSS ↓ 97.3%", font=mono_font, size=30, color=ICE), pos=(340, 150),
               time=[17.4, 19.5], transition_in="glitch(0.2, intensity=0.6)",
               fx=[glow(color=CYAN, intensity=0.8, radius=10)])

        // rising data motes — noise-scattered, $t-driven ascent
        repeat 24 times as j:
            render(shape("circle", radius=2.6, fill=CYAN),
                   pos=(330 + (j % 8) * 186 + noise(j, 3, 11) * 70,
                        920 - ($t - 12.6) * (58 + (j % 5) * 26)),
                   time=[12.9 + (j % 6) * 0.5, 19.5], opacity=0.75 -> 0.0,
                   fx=[blend_mode("add")])

        // HUD stat cards from the imported component module
        stat_badge("TRAINING DATA", "15 TB / DAY", 1560, 180, 13.6)
        stat_badge("PARAMETERS", "1.8 TRILLION", 1560, 300, 14.1)
        stat_badge("ACCURACY", "99.2%", 1560, 420, 14.6)

        // live Wikipedia knowledge card (fetcher.py) with reflection
        render(wiki("Artificial intelligence"), pos=(1560, 660), time=[15.0, 19.5],
               scale=0 -> 1, ease=bounce,
               transition_in="zoom_in(0.6)",
               fx=[drop_shadow(offset_x=0, offset_y=16, blur=30, color="#000000B4"),
                   reflection(opacity=0.35, blur=6, gap=10, fade=true)])

    layer(z=8):
        render(text("THE LEARNING CURVE", class="section-title", anchor="center"),
               pos=(CX, 90), time=[12.9, 19.5],
               fx=[float_y(distance=6, speed=0.6)],
               transition_in="wipe_left(0.6)", transition_out="wipe_right(0.5)")

    // ========================================================================
    // Z=5 · SCENE 4 — TIMELINE OF PROGRESS (19–26s)
    // milestone bounces + scanner head driven by lerp/clamp/map_range
    // ========================================================================
    layer(z=5):
        years  = ["1950", "1997", "2012", "2017", "2022", "2025"]
        names  = ["TURING TEST", "DEEP BLUE", "DEEP LEARNING", "TRANSFORMERS", "LARGE MODELS", "AI AGENTS"]
        levels = [0.5, 1.1, 2.4, 4.0, 6.6, 9.4]

        // baseline draws with a linear keyframe
        render(shape("line", x1=220, y1=560, x2=1700, y2=560, color="#27405F", width=3),
               time=[19.4, 26], scale=0 -> 1, ease=linear,
               transition_in="wipe_right(0.7)")

        // glowing scanner head riding the timeline
        render(shape("circle", radius=9, fill="#FFFFFF"),
               pos=(lerp(240, 1680, clamp(map_range($t, 19.6, 25.4, 0, 1), 0, 1)), 560),
               time=[19.6, 25.6],
               fx=[glow(color="#FFFFFF", intensity=2.4, radius=26),
                   motion_blur(samples=10, direction=0, distance=14)],
               transition_out="crossfade(0.4)")

        for i in range(6):
            mx = 262 + i * 276
            mh = levels[i] * 46
            render(shape("circle", radius=11, fill=stage_color(i)), pos=(mx, 560),
                   time=[19.9 + i * 0.55, 26], scale=0 -> 1, ease=bounce,
                   fx=[glow(color=stage_color(i), intensity=2.1, radius=26)])
            render(shape("rect", width=6, height=mh, color=stage_color(i), radius=3),
                   pos=(mx, 560 - mh * 0.5), time=[20.1 + i * 0.55, 26],
                   scale=0.08 -> 1.0, ease=ease_out, opacity=0.9)
            render(text(years[i], font=mono_font, size=27, color="#9FB4D8", anchor="center"),
                   pos=(mx, 616), time=[20.1 + i * 0.55, 26], transition_in="slide_up(0.4)")
            render(text(names[i], font=ui_font, size=23, color="#FFFFFF", anchor="center"),
                   pos=(mx, 660), time=[20.25 + i * 0.55, 26], opacity=0 -> 1, ease=ease_in)

        // conditional branch — forecast arrow once history is complete
        show_forecast = true
        if show_forecast:
            render(shape("polygon", sides=3, radius=30, fill=GOLD),
                   pos=(1700, 470), time=[23.6, 26], scale=0 -> 1, ease=bounce,
                   fx=[glow(color=GOLD, intensity=2.0, radius=30), pulse(amount=0.12, speed=2.2)])
            render(text("EXPONENTIAL AHEAD", font=mono_font, size=26, color=GOLD),
                   pos=(1600, 400), time=[23.8, 26], opacity=0 -> 1, ease=ease_out,
                   fx=[glow(color=GOLD, intensity=1.0, radius=12)])

    layer(z=8):
        render(text("SEVEN DECADES OF SMARTER", class="section-title", anchor="center"),
               pos=(CX, 120), time=[19.6, 26],
               transition_in="slide_down(0.6)", transition_out="crossfade(0.5)")
        ticker("MOTION LANGUAGE · RENDERED IN .HMG · PYTHON → MOVIEPY → PIXELS", 1032, 2, 30)

    // ========================================================================
    // Z=8 · SCENE 5 — FINALE (25.5–32s)
    // letter-staggered CSS hero title, light sweep, logo, $frame watermark
    // ========================================================================
    layer(z=8):
        // halo ring scaled by the logistic GrowthModel output
        render(shape("circle", radius=330 * peak, fill="none", stroke=CYAN, stroke_width=2),
               pos=(CX, CY), time=[25.8, 32], scale=0.4 -> 1.0, ease=ease_out, opacity=0 -> 0.8,
               fx=[glow(color=CYAN, intensity=1.4, radius=40), blend_mode("screen")])

        render(text("AI BECOMES", font=ui_font, size=54, color=ICE, anchor="center"),
               pos=(CX, CY - 200), time=[26.0, 32], opacity=0 -> 1, ease=ease_in,
               transition_in="slide_down(0.6)")

        // letter-by-letter staggered bounce reveal (CSS class supplies type)
        word = "SMARTER"
        for i in range(7):
            render(text(word[i], class="hero-title", anchor="center"),
                   pos=(CX - 468 + i * 156, CY + 10), time=[26.4 + i * 0.13, 32],
                   scale=0.35 -> 1.0, ease=bounce,
                   fx=[glow(color=CYAN, intensity=1.6, radius=30),
                       light_sweep(progress=$t, angle=32, speed=0.55, width=0.2, color="#FFFFFF"),
                       vfx_preset("neon_bloom", intensity=1.15)],
                   transition_in="zoom_in(0.45)")

        render(text(agi_caption, class="chip", anchor="center"),
               pos=(CX, CY + 190), time=[27.6, 32], scale=0.8 -> 1.0, ease=ease_out,
               transition_in="slide_up(0.5)")

        render(text("THE NEXT INTELLIGENCE REVOLUTION STARTS HERE", font=web_font, size=30, color="#9FB4D8", anchor="center"),
               pos=(CX, CY + 268), time=[28.2, 32], opacity=0 -> 1, ease=ease_in_out)

        // golden diamonds with float transform-FX
        render(shape("polygon", sides=4, radius=24, fill=GOLD), pos=(CX - 640, CY + 10), time=[27.0, 32],
               scale=0 -> 1, ease=bounce,
               fx=[glow(color=GOLD, intensity=1.6, radius=20), float_y(distance=16, speed=1.1)])
        render(shape("polygon", sides=4, radius=24, fill=GOLD), pos=(CX + 640, CY + 10), time=[27.0, 32],
               scale=0 -> 1, ease=bounce,
               fx=[glow(color=GOLD, intensity=1.6, radius=20), float_y(distance=16, speed=1.1)])

        // OPTIONAL LOGO — image() asset, guarded
        if os.path.exists("assets/logo/logo.png"):
            render(image("assets/logo/logo.png"), pos=(110, H - 90), time=[28.5, 32],
                   scale=0 -> 0.8, ease=bounce, opacity=0.9)

    // ========================================================================
    // Z=9 · OPTICAL LAYER — scene-hit flashes + closing fade + watermark
    // ========================================================================
    layer(z=9):
        render(shape("rect", width=W, height=H, color="#FFFFFF"), time=[5.2, 5.9],   opacity=0.55 -> 0.0, ease=ease_out)
        render(shape("rect", width=W, height=H, color="#FFFFFF"), time=[12.4, 13.0], opacity=0.45 -> 0.0, ease=ease_out)
        render(shape("rect", width=W, height=H, color="#FFFFFF"), time=[19.0, 19.6], opacity=0.45 -> 0.0, ease=ease_out)
        render(shape("rect", width=W, height=H, color="#FFFFFF"), time=[25.5, 26.4], opacity=0.90 -> 0.0, ease=ease_out)
        render(shape("rect", width=W, height=H, color="#000000"), time=[31.2, DURATION], opacity=0 -> 1, ease=ease_in)

        // $frame-driven watermark fade-in (first two seconds at 60fps)
        render(text("■ MOTION LANGUAGE 1.2 — .HMG", class="watermark"),
               pos=(W - 380, H - 44), time=[0, DURATION],
               opacity=clamp($frame / 120, 0, 0.85))