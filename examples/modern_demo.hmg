        render(shape("circle", width=680, height=680, color="#10334A"), pos=(590, 190), time=[0, 55.8], opacity=0.16, fx=[blur(radius=70), pulse(amount=0.05, speed=0.35)])
        render(shape("circle", width=550, height=550, color="#23421F"), pos=(-120, 1040), time=[0, 55.8], opacity=0.12, fx=[blur(radius=65), pulse(amount=0.06, speed=0.42)])
        render(shape("circle", width=330, height=330, color="#29204B"), pos=(710, 1320), time=[0, 55.8], opacity=0.12, fx=[blur(radius=50), float_y(distance=22, speed=0.32)])

