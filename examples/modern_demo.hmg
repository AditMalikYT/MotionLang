// ============================================================================
// FREE CLAUDE CODE? — CINEMATIC SHORT V2
// Motion Language 1.1 | Modern indentation-based DSL
// Canvas: 1080 x 1920 | 30 FPS | Duration: 55.8 seconds | 9:16 vertical
//
// Design upgrade:
//   - Editorial, high-contrast typography with Google Fonts fallback
//   - Persistent technical HUD, animated scan rails, drifting light nodes
//   - Shot-specific compositions instead of one repeated center card
//   - Keyframed entrances/exits, glow, pulse, motion blur, chromatic glitch
//   - Multi-step workflow montage and clean chat-versus-agent comparison
//   - Final shot returns to the opening composition for a visual loop
//
// Run from the Motion Language project:
//   motion render /path/to/free-claude-code.hmg
//
// The visual footage is created from vector shapes and typography. For final
// publication, place a CURRENT, REAL pricing-page capture at
// assets/claude_pricing_capture.png and uncomment the optional image render
// noted in the proof-check scene. Do not present a recreated pricing table as
// an official screenshot. Add voice/music/SFX in the optional audio layer.
// ============================================================================

config:
    resolution = 1080x1920
    fps = 30

// Motion Language 1.1 typography: dynamic Google Font fetch with offline fallback.
headline_font = load_font("Poppins", weight="bold")
body_font = load_font("Inter", weight="medium")
code_font = load_font("JetBrains Mono", weight="medium")

// ---------------------------------------------------------------------------
// SCRIPT / EDIT MAP (voiceover should run continuously; timings are targets)
// ---------------------------------------------------------------------------
// [00:00 - 00:01.8] Want Claude Code for FREE?
// [00:01.8 - 00:03.8] Here's the catch most videos skip.
// [00:03.8 - 00:06.15] Claude Free can still help you code.
// [00:06.15 - 00:08.15] Ask for snippets or bug fixes.
// [00:08.15 - 00:10.15] Build a page, or explain errors.
// [00:10.15 - 00:12.5] Create files and run code in chat.
// [00:12.5 - 00:14.5] But that's not Claude Code itself.
// [00:14.5 - 00:16.85] That coding agent works in your terminal.
// [00:16.85 - 00:18.65] Anthropic lists Claude Code as—
// [00:18.65 - 00:20.65] NOT INCLUDED on the Free plan.
// [00:20.65 - 00:23.0] Pro includes it; Console use needs billing.
// [00:23.0 - 00:24.5] "Unlimited free access" claims?
// [00:24.5 - 00:26.5] CHECK FIRST before trusting the headline.
// [00:26.5 - 00:28.5] A zero-cost option is Claude's chat.
// [00:28.5 - 00:30.85] Paste a small snippet; explain your goal.
// [00:30.85 - 00:32.85] Ask for fixes and brief explanations.
// [00:32.85 - 00:34.85] Copy the change into your project.
// [00:34.85 - 00:37.2] Then test it and check for errors.
// [00:37.2 - 00:39.55] Need the terminal agent? Check official pricing.
// [00:39.55 - 00:41.9] Access and prices change, so verify today.
// [00:41.9 - 00:43.9] Know which tool you're actually getting.
// [00:43.9 - 00:45.7] Free Claude can code; but—
// [00:45.7 - 00:47.5] Claude Code itself is paid.
// [00:47.5 - 00:49.85] That's what viral posts often leave out.
// [00:49.85 - 00:52.2] Save this before chasing a free trick.
// [00:52.2 - 00:54.0] And now, the question remains:
// [00:54.0 - 00:55.8] Want Claude Code for FREE?

scene:
    // ========================================================================
