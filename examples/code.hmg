// FREE CLAUDE CODE — 9:16 VIRAL SHORT
// Motion Language v1.2 | Modern DSL
// Creative angle: "Claude is free. But Claude Code?"
// Target: 1080x1920, 30fps, 36 seconds
// Note: Uses native shapes and typography so the scene can render without downloaded footage.
// Voiceover/music should be mixed in during the final audio pass.

config:
    resolution = 1080x1920
    fps = 30
    duration = 36

// ---------- GLOBAL BACKGROUND ----------
scene:
    layer(z=0):
        render(shape("rect", width=1080, height=1920, color="#070A12"), time=[0, 36])
        render(shape("rect", width=1080, height=10, color="#B7FF35"), pos=(0, 0), time=[0, 36], opacity=0.95)
        render(shape("rect", width=1080, height=4, color="#1A3340"), pos=(0, 1910), time=[0, 36], opacity=0.9)
        render(shape("circle", radius=360, color="#0B2530"), pos=(540, 500), time=[0, 36], opacity=0.34, fx=[blur(radius=60)])
        render(shape("circle", radius=260, color="#172018"), pos=(540, 1420), time=[0, 36], opacity=0.32, fx=[blur(radius=60)])

    // Fine scan lines and framing marks
    layer(z=1):
        repeat 18 times as i:
            render(shape("rect", width=920, height=1, color="#24313B"), pos=(80, 180 + i*88), time=[0, 36], opacity=0.22)
        render(shape("rect", width=2, height=1420, color="#33424C"), pos=(70, 250), time=[0, 36], opacity=0.45)
        render(shape("rect", width=2, height=1420, color="#33424C"), pos=(1008, 250), time=[0, 36], opacity=0.45)


// ---------- SCENE 1: HOOK (00:00–00:04) ----------
scene:
    layer(z=5):
        render(text("CLAUDE IS FREE.", font="Poppins", weight="bold", size=76, color="#F4F7FA", align="center"), pos=(540, 600), time=[0, 2.3], scale=0.65 -> 1.0, opacity=0.0 -> 1.0, fx=[glow(color="#FFFFFF", intensity=0.35, radius=12)])
        render(text("BUT CLAUDE CODE?", font="Poppins", weight="bold", size=67, color="#B7FF35", align="center"), pos=(540, 720), time=[1.1, 4], scale=1.25 -> 1.0, opacity=0.0 -> 1.0, fx=[glow(color="#B7FF35", intensity=0.8, radius=24)])
        render(shape("rect", width=720, height=5, color="#B7FF35"), pos=(180, 795), time=[1.3, 4], scale=0.2 -> 1.0)
        render(text("THE PRICE TRAP", font="Poppins", weight="bold", size=30, color="#7E929F", align="center"), pos=(540, 875), time=[2.1, 4], opacity=0.0 -> 1.0)
        render(shape("rect", width=850, height=250, color="#111A25"), pos=(115, 1080), time=[0.4, 4], fx=[glow(color="#B7FF35", intensity=0.18, radius=18)])
        render(text("> claude --free?", font="monospace", weight="bold", size=40, color="#B7FF35", align="center"), pos=(540, 1195), time=[0.6, 4], opacity=0.0 -> 1.0)
    layer(z=6):
        render(shape("rect", width=1080, height=1920, color="#FFFFFF"), time=[0.02, 0.12], opacity=0.18 -> 0.0)


// ---------- SCENE 2: THE DISTINCTION (00:04–00:09) ----------
scene:
    layer(z=5):
        render(text("TWO DIFFERENT THINGS.", font="Poppins", weight="bold", size=51, color="#F4F7FA", align="center"), pos=(540, 390), time=[4, 7], scale=0.8 -> 1.0)
        render(shape("rect", width=400, height=360, color="#101923"), pos=(95, 620), time=[4.2, 9], fx=[glow(color="#31596B", intensity=0.25, radius=16)])
        render(shape("rect", width=400, height=360, color="#101923"), pos=(585, 620), time=[4.2, 9], fx=[glow(color="#B7FF35", intensity=0.3, radius=16)])
        render(text("CLAUDE CHAT", font="Poppins", weight="bold", size=35, color="#F4F7FA", align="center"), pos=(295, 700), time=[4.4, 9])
        render(text("FREE PLAN", font="Poppins", weight="bold", size=36, color="#B7FF35", align="center"), pos=(295, 800), time=[4.5, 9])
        render(text("Ask for code", font="Poppins", size=27, color="#A6B4C0", align="center"), pos=(295, 880), time=[4.5, 9])
        render(text("CLAUDE CODE", font="Poppins", weight="bold", size=34, color="#F4F7FA", align="center"), pos=(785, 700), time=[4.4, 9])
        render(text("PAID PLAN", font="Poppins", weight="bold", size=36, color="#B7FF35", align="center"), pos=(785, 800), time=[4.5, 9])
        render(text("Works in terminal", font="Poppins", size=25, color="#A6B4C0", align="center"), pos=(785, 880), time=[4.5, 9])
        render(text("CHAT ≠ TERMINAL AGENT", font="Poppins", weight="bold", size=36, color="#FFCE57", align="center"), pos=(540, 1100), time=[6.2, 9], scale=0.8 -> 1.0, fx=[glow(color="#FFCE57", intensity=0.35, radius=12)])
        render(text("Same brand. Different access.", font="Poppins", size=28, color="#91A0AD", align="center"), pos=(540, 1180), time=[6.6, 9])


// ---------- SCENE 3: PRICE REVEAL (00:09–00:14) ----------
scene:
    layer(z=5):
        render(text("HERE'S THE CATCH", font="Poppins", weight="bold", size=43, color="#A6B4C0", align="center"), pos=(540, 420), time=[9, 11])
        render(text("$0", font="Poppins", weight="bold", size=190, color="#B7FF35", align="center"), pos=(540, 670), time=[9.2, 11.8], scale=0.5 -> 1.0, fx=[glow(color="#B7FF35", intensity=1.1, radius=36)])
        render(text("CLAUDE FREE PLAN", font="Poppins", weight="bold", size=36, color="#F4F7FA", align="center"), pos=(540, 820), time=[9.4, 12])
        render(shape("rect", width=720, height=3, color="#33424C"), pos=(180, 920), time=[10, 14])
        render(text("CLAUDE CODE IS NOT", font="Poppins", weight="bold", size=47, color="#FFCE57", align="center"), pos=(540, 1030), time=[11.7, 14], scale=0.7 -> 1.0, fx=[glow(color="#FFCE57", intensity=0.45, radius=16)])
        render(text("included in the free tier", font="Poppins", size=31, color="#C5D0D8", align="center"), pos=(540, 1110), time=[12, 14])
        render(text("Check current plan details", font="Poppins", size=23, color="#718392", align="center"), pos=(540, 1220), time=[12.5, 14])


// ---------- SCENE 4: THE PRACTICAL TAKEAWAY (00:14–00:21) ----------
scene:
    layer(z=5):
        render(text("SO WHAT CAN YOU DO?", font="Poppins", weight="bold", size=48, color="#F4F7FA", align="center"), pos=(540, 380), time=[14, 16.5])
        render(shape("rect", width=820, height=170, color="#111A25"), pos=(130, 520), time=[14.2, 21], fx=[glow(color="#B7FF35", intensity=0.15, radius=12)])
        render(text("01", font="Poppins", weight="bold", size=39, color="#B7FF35", align="center"), pos=(220, 600), time=[14.4, 21])
        render(text("Use Claude chat to write code", font="Poppins", weight="bold", size=31, color="#F4F7FA", align="center"), pos=(590, 600), time=[14.4, 21])
        render(shape("rect", width=820, height=170, color="#111A25"), pos=(130, 725), time=[15.2, 21], fx=[glow(color="#31596B", intensity=0.18, radius=12)])
        render(text("02", font="Poppins", weight="bold", size=39, color="#B7FF35", align="center"), pos=(220, 805), time=[15.4, 21])
        render(text("Need terminal automation?", font="Poppins", weight="bold", size=29, color="#F4F7FA", align="center"), pos=(600, 790), time=[15.4, 21])
        render(text("Check paid-plan access", font="Poppins", size=27, color="#A6B4C0", align="center"), pos=(600, 835), time=[15.4, 21])
        render(text("Don't confuse free chat with free CLI access.", font="Poppins", weight="bold", size=31, color="#FFCE57", align="center"), pos=(540, 1040), time=[17.5, 21], scale=0.85 -> 1.0)
        render(text("Plans and limits can change.", font="Poppins", size=24, color="#718392", align="center"), pos=(540, 1120), time=[18, 21])


// ---------- SCENE 5: CTA + LOOP (00:21–00:36) ----------
scene:
    layer(z=5):
        render(text("SAVE THIS BEFORE", font="Poppins", weight="bold", size=52, color="#F4F7FA", align="center"), pos=(540, 470), time=[21, 24], scale=0.8 -> 1.0)
        render(text("YOU INSTALL ANYTHING.", font="Poppins", weight="bold", size=48, color="#B7FF35", align="center"), pos=(540, 550), time=[21.5, 24.5], scale=0.8 -> 1.0, fx=[glow(color="#B7FF35", intensity=0.45, radius=16)])
        render(shape("rect", width=760, height=230, color="#101923"), pos=(160, 720), time=[22, 27], fx=[glow(color="#31596B", intensity=0.25, radius=20)])
        render(text("FREE CHAT", font="Poppins", weight="bold", size=40, color="#B7FF35", align="center"), pos=(540, 790), time=[22.2, 27])
        render(text("≠", font="Poppins", weight="bold", size=74, color="#FFCE57", align="center"), pos=(540, 865), time=[22.2, 27])
        render(text("FREE CLAUDE CODE", font="Poppins", weight="bold", size=38, color="#F4F7FA", align="center"), pos=(540, 945), time=[22.2, 27])
        render(text("Follow for no-hype AI tools.", font="Poppins", size=29, color="#A6B4C0", align="center"), pos=(540, 1100), time=[25, 29])
        render(text("NOW, THE QUESTION IS…", font="Poppins", weight="bold", size=36, color="#A6B4C0", align="center"), pos=(540, 1380), time=[28, 31])
        render(text("CLAUDE IS FREE.", font="Poppins", weight="bold", size=68, color="#F4F7FA", align="center"), pos=(540, 1490), time=[30, 33], scale=0.85 -> 1.0)
        render(text("BUT CLAUDE CODE?", font="Poppins", weight="bold", size=60, color="#B7FF35", align="center"), pos=(540, 1590), time=[32, 36], scale=0.9 -> 1.05, fx=[glow(color="#B7FF35", intensity=0.7, radius=22)])
        render(shape("rect", width=700, height=4, color="#B7FF35"), pos=(190, 1660), time=[32, 36], scale=0.2 -> 1.0)


// ---------- EDITORIAL NOTES ----------
// Voiceover: bright, confident, crisp; 165–175 WPM; no intentional pauses.
// Suggested BGM: 132 BPM dark-tech / kinetic electronic, instrumental, duck to -18 dB under VO.
// Suggested SFX: sub impact at 00:00; short whoosh at 00:02; clicks on 00:04 / 00:09;
// bass hit on "$0"; UI ticks on checklist; reverse riser into 00:30 loop reset.
// Keep key captions inside central safe area; no important text in top/bottom UI zones.
// Verify plan details before publishing: Claude Free does not include Claude Code per official pricing page checked 2026-10-10.
