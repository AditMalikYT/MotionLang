// ============================================================================
//  AI BECOMES SMARTER — 9:16 VERTICAL CUT (Reels / Shorts / TikTok)
//  Motion Language 1.2 • 1080x1920 @ 60fps • neural voiceover synced
// ----------------------------------------------------------------------------
//  SMOOTH-MOTION TOOLKIT USED HERE:
//    • smoothstep easing fn() for buttery camera moves
//    • slow-out staggers + 1.0s crossfade overlaps between scenes
//    • parallax $t drift on background / midground / foreground
//    • motion_blur on fast movers, pulse/float transform-fx everywhere
//  VOICE MAP (edge-tts clips rendered on z=0):
//    s1 0.4–6.2  IGNITION          s3 13.1–19.4 LEARNING CURVE
//    s2 6.3–13.0 CONSTELLATION     s4 19.6–25.9 TIMELINE
//                                   s5 26.1–31.8 FINALE
//  SAFE ZONE: keep hero content inside y=180..1650 (platform UI overlays edges)
// ============================================================================

config:
    resolution = 1080x1920
    fps = 60

// ---------- PYTHON INTEROP ----------
import math
import numpy as np
import os.path
import helpers

// ---------- MODULE SYSTEM ----------
import stat_badge, ticker from "hud_components.hmg"

// ---------- CSS + GOOGLE FONTS ----------
import styles from "theme.css"
hero_font = load_font("Space Grotesk", weight="700")
ui_font   = load_font("Inter", weight="600")
mono_font = load_font("JetBrains Mono", weight="400")
cta_font  = load_font("Poppins", weight="bold", url="https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap")

// ---------- CONSTANTS ----------
W = 1080
H = 1920
CX = 540
CY = 960
DURATION = 32

CYAN    = "#00E5FF"
VIOLET  = "#7C4DFF"
MAGENTA = "#FF007F"
GOLD    = "#FFC24B"
ICE     = "#EAF6FF"
BG      = "#04060E"

// ---------- FUNCTIONS & CLASSES ----------
fn smooth(x):
    return x * x * (3 - 2 * x)              // smoothstep: ultra-smooth easing

fn stage_color(i):
    palette = [CYAN, VIOLET, MAGENTA, GOLD]
    return palette[i % 4]

fn ring_point(angle, radius, squash):
    return (CX + cos(angle) * radius, CY - 120 + sin(angle) * radius * squash)

class GrowthModel:
    fn capability(self, t):
        return 1.0 / (1.0 + pow(e, -1.1 * (t - 3.0)))
    fn stage_name(self, level):
        if level > 0.75:
            return "AGI HORIZON"
        elif level > 0.40:
            return "DEEP LEARNING"
        else:
            return "NARROW AI"

model = GrowthModel()
agi_caption = model.stage_name(0.9)
peak = model.capability(6.0)

scene:

    // ========================================================================
    // Z=0 · VOICEOVER — five free neural clips, scene-synced (+ optional bed)
    // ========================================================================
    layer(z=0):
        if os.path.exists("voice/s1.mp3"):
            render(audio("voice/s1.mp3"), time=[0.4, 6.2])
        if os.path.exists("voice/s2.mp3"):
            render(audio("voice/s2.mp3"), time=[6.3, 13.0])
        if os.path.exists("voice/s3.mp3"):
            render(audio("voice/s3.mp3"), time=[13.1, 19.4])
        if os.path.exists("voice/s4.mp3"):
            render(audio("voice/s4.mp3"), time=[19.6, 25.9])
        if os.path.exists("voice/s5.mp3"):
            render(audio("voice/s5.mp3"), time=[26.1, 31.8])
        // optional ambient bed — pre-duck it to ~-18 LUFS externally (no mixer in DSL)
        if os.path.exists("assets/music_bed.mp3"):
            render(audio("assets/music_bed.mp3"), time=[0, DURATION])

    // ========================================================================
    // Z=1 · BACKGROUND — vignette + breathing parallax nebulae ($t drift)
    // ========================================================================
    layer(z=1):
        render(shape("rect", width=W, height=H, color=BG), time=[0, DURATION],
               fx=[vignette(amount=0.6)])

        render(shape("ellipse", width=900, height=760, color="#0D2740"),
               pos=(260 + sin($t * 0.18) * 60, 430 + cos($t * 0.15) * 50),
               time=[0, DURATION], opacity=0.55,
               scale=1.0 + sin($t * 0.4) * 0.03,
               fx=[blur(radius=75), blend_mode("screen")])
        render(shape("ellipse", width=860, height=720, color="#35103F"),
               pos=(830 + cos($t * 0.14) * 70, 1280 + sin($t * 0.20) * 60),
               time=[0, DURATION], opacity=0.48,
               scale=1.0 + cos($t * 0.35) * 0.03,
               fx=[blur(radius=85), blend_mode("screen")])
        render(shape("ellipse", width=1000, height=640, color="#062E2B"),
               pos=(540 + sin($t * 0.11) * 90, 1760),
               time=[0, DURATION], opacity=0.40,
               fx=[blur(radius=90), blend_mode("add")])

        // OPTIONAL B-ROLL PLATE — lazy cut/trim/speed/pos chain (v1.2)
        if os.path.exists("assets/broll_ai.mp4"):
            plate = video("assets/broll_ai.mp4", start=4.0, end=18.0, speed=0.75)
            render(plate.cut(start=2.0, end=12.0).trim(start=0.5, duration=7.0).speed(0.8).pos((0, 0)),
                   time=[5.4, 13], opacity=0.20,
                   fx=[adjust_color(brightness=-0.12, contrast=0.18, saturation=0.35),
                       blend_mode("screen")],
                   transition_in="crossfade(1.2)", transition_out="crossfade(0.9)")

    // ========================================================================
    // Z=2 · SCENE 1 — IGNITION (0–6s): converging grid, boot HUD, first neuron
    // ========================================================================
    layer(z=2):
        // converging vertical perspective lines
        for i in range(9):
            x0 = i * 135
            render(shape("line", x1=x0, y1=1920, x2=CX + (x0 - CX) * 0.35, y2=1150, color="#10233C", width=1),
                   time=[0, 6.4], opacity=0.6 -> 0.0, ease=linear)
        for i in range(8):
            gy = 1190 + i * i * 6.2
            render(shape("line", x1=0, y1=gy, x2=W, y2=gy, color="#0C1B30", width=1),
                   time=[0, 6.4], opacity=0.55 -> 0.0, ease=linear)

        render(text("SIGNAL ACQUIRED // NEURAL LINK ONLINE", font=mono_font, size=22, color=CYAN),
               pos=(64, 150), time=[0.2, 2.6],
               fx=[glitch(intensity=0.45, seed=7), chromatic_aberration(offset=3)],
               transition_in="glitch(0.25, intensity=0.8)")
        render(text("MODEL: HM-∞ · PARAMS: 1.8T · STATE: WAKING", font=mono_font, size=22, color="#5E7BA6"),
               pos=(64, 188), time=[0.6, 2.6], opacity=0 -> 1, ease=ease_in)

        repeat 5 times as k:
            render(shape("circle", radius=64 + k * 56, fill="none", stroke=CYAN, stroke_width=2),
                   pos=(CX, 830), time=[0.6 + k * 0.32, 4.0 + k * 0.32],
                   scale=0.15 -> 1.0, opacity=0.85 -> 0.0, ease=ease_out)

    layer(z=6):
        render(shape("circle", radius=12, fill=CYAN), pos=(CX, 830), time=[0.4, 6.2],
               scale=0 -> 1.5, ease=ease_out,
               fx=[glow(color=CYAN, intensity=2.6, radius=44),
                   flash_in(duration=0.28, color="#FFFFFF")],
               transition_in="glitch(0.35, intensity=0.9)")

        render(text("AI", font=hero_font, size=260, color="#FFFFFF", anchor="center"),
               pos=(CX, 834), time=[1.2, 6.2],
               scale=0.62 -> 1.0, ease=ease_out,
               fx=[glow(color=CYAN, intensity=1.7, radius=34),
                   chromatic_aberration(offset=4),
                   drop_shadow(offset_x=0, offset_y=16, blur=30, color="#000000AA")],
               transition_in="glitch(0.3, intensity=0.8)", transition_out="crossfade(0.9)")

        render(text("THE SPARK OF MACHINE INTELLIGENCE", font=ui_font, size=30, color=ICE, anchor="center"),
               pos=(CX, 1060), time=[2.3, 6.2], opacity=0 -> 1, ease=ease_in,
               fx=[glow(color=CYAN, intensity=0.7, radius=12)],
               transition_in="slide_up(0.6)", transition_out="crossfade(0.8)")

    // ========================================================================
    // Z=3 · SCENE 2 — NEURAL CONSTELLATION (5.4–13s), centered for portrait
    // ========================================================================
    layer(z=3):
        N = 56
        angles = np.linspace(0, 9 * pi, N)

        repeat 18 times as k:
            a1 = (k / 18) * tau
            a2 = a1 + 0.85 + (k % 3) * 0.75
            p1 = ring_point(a1, 165 + (k % 4) * 58, 0.95)
            p2 = ring_point(a2, 165 + ((k + 2) % 4) * 58, 0.95)
            render(shape("line", x1=p1[0], y1=p1[1], x2=p2[0], y2=p2[1], color="#1D4A66", width=1.4),
                   time=[6.2 + k * 0.11, 13], opacity=0 -> 0.6, ease=ease_in,
                   transition_in="crossfade(0.8)")

        // golden-spiral particles on breathing Lissajous orbits
        for i in range(N):
            base_r  = helpers.golden_spiral_radius(i, 20.0)
            spd     = helpers.orbit_speed(i)
            ph      = angles[i]
            shimmer = sqrt(i + 1) * 3.0
            render(shape("circle", radius=2 + (i % 4), fill=stage_color(i)),
                   pos=(CX + sin($t * 0.4) * 10 + cos(ph + $t * spd) * (base_r + sin($t * 1.6 + i) * shimmer),
                        840 + cos($t * 0.33) * 8 + sin(ph + $t * spd) * (base_r + sin($t * 1.6 + i) * shimmer) * 0.95),
                   time=[5.6, 13], opacity=0.30 + (i % 3) * 0.22,
                   fx=[blend_mode("screen")],
                   transition_in="crossfade(1.1)")

        // reactor core — pulse + animated light sweep, gentle parallax drift
        render(shape("circle", radius=100, fill="#08182B"),
               pos=(CX + sin($t * 0.4) * 10, 840 + cos($t * 0.33) * 8),
               time=[5.4, 13], scale=0 -> 1, ease=ease_in_out,
               fx=[glow(color=CYAN, intensity=1.9, radius=60),
                   light_sweep(angle=45, speed=0.9, width=0.22, color="#FFFFFF"),
                   pulse(amount=0.05, speed=1.25)])
        render(shape("ellipse", width=500, height=140, fill="none", stroke=VIOLET, stroke_width=2),
               pos=(CX, 840), time=[6.0, 13], opacity=0 -> 0.7, ease=ease_out,
               fx=[float_y(distance=10, speed=0.7), blend_mode("screen")])

    layer(z=7):
        cap1 = render(text("LEARNING", class="chip", anchor="center"), pos=(CX, 1420), time=[7.0, 9.0],
                      transition_in="slide_up(0.5)", transition_out="crossfade(0.5)")
        cap2 = render(text("REASONING", class="chip", anchor="center"), pos=(CX, 1420), time=[9.0, 11.0])
        cap3 = render(text("CREATING", class="chip", anchor="center"), pos=(CX, 1420), time=[11.0, 13.0])
        transition(from=cap1, to=cap2, type="crossfade", duration=0.6)
        transition(from=cap2, to=cap3, type="glitch", duration=0.4)

    layer(z=8):
        render(text("NETWORKS LEARN TO LEARN", class="section-title", anchor="center"),
               pos=(CX + noise($t, 0, 7) * 22, 240 + noise(0, $t, 7) * 14),
               time=[6.6, 13],
               transition_in="wipe_down(0.7)", transition_out="crossfade(0.9)")

    // ========================================================================
    // Z=4 · SCENE 3 — THE LEARNING CURVE (12.5–19.5s): vertical-rise chart
    // ========================================================================
    layer(z=4):
        repeat 12 times as i:
            bh = helpers.log_growth(i, 80.0, 430.0)
            bx = 150 + i * 66
            render(shape("rect", width=42, height=bh, color=stage_color(i), radius=7),
                   pos=(bx, 1480 - bh * 0.5), time=[13.2 + i * 0.12, 19.5],
                   scale=0.06 -> 1.0, ease=ease_out,
                   fx=[glow(color=stage_color(i), intensity=0.55, radius=10)],
                   transition_in="slide_up(0.4)")

        render(shape("path", d="M 140 1480 C 340 1470, 520 1400, 660 1260 S 900 1010, 950 970",
                       color=GOLD, width=4, fill="none"),
               time=[14.4, 19.5], transition_in="wipe_right(1.0)",
               fx=[glow(color=GOLD, intensity=1.5, radius=18),
                   motion_blur(samples=8, direction=0, distance=10)])

        // spiking-neuron wave: tan(clamp(sin()))
        for i in range(16):
            render(shape("circle", radius=3, fill=CYAN),
                   pos=(180 + i * 48, 900 + tan(clamp(sin($t * 2.4 + i * 0.55), -0.86, 0.86)) * 56),
                   time=[13.0, 19.5], opacity=0.85,
                   fx=[blend_mode("add")])

        render(text("EPOCH 001", font=mono_font, size=26, color="#5E7BA6"), pos=(80, 350), time=[13.0, 15.2])
        render(text("EPOCH 010", font=mono_font, size=26, color="#8FB0DE"), pos=(80, 350), time=[15.2, 17.4],
               transition_in="glitch(0.2, intensity=0.6)")
        render(text("EPOCH 100 — LOSS ↓ 97.3%", font=mono_font, size=26, color=ICE), pos=(80, 350),
               time=[17.4, 19.5], transition_in="glitch(0.2, intensity=0.6)",
               fx=[glow(color=CYAN, intensity=0.8, radius=10)])

        repeat 20 times as j:
            render(shape("circle", radius=2.6, fill=CYAN),
                   pos=(140 + (j % 5) * 190 + noise(j, 3, 11) * 60,
                        1560 - ($t - 12.6) * (55 + (j % 5) * 24)),
                   time=[12.9 + (j % 6) * 0.5, 19.5], opacity=0.7 -> 0.0,
                   fx=[blend_mode("add")])

        stat_badge("TRAINING DATA", "15 TB / DAY", 540, 480, 13.6)
        stat_badge("PARAMETERS", "1.8 TRILLION", 540, 600, 14.1)
        stat_badge("ACCURACY", "99.2%", 540, 720, 14.6)

    layer(z=8):
        render(text("THE LEARNING CURVE", class="section-title", anchor="center"),
               pos=(CX, 240), time=[12.9, 19.5],
               fx=[float_y(distance=6, speed=0.6)],
               transition_in="wipe_left(0.7)", transition_out="wipe_right(0.6)")

    // ========================================================================
    // Z=5 · SCENE 4 — TIMELINE OF PROGRESS (19–26s): vertical spine + scanner
    // ========================================================================
    layer(z=5):
        years  = ["1950", "1997", "2012", "2017", "2022", "2025"]
        names  = ["TURING TEST", "DEEP BLUE", "DEEP LEARNING", "TRANSFORMERS", "LARGE MODELS", "AI AGENTS"]
        levels = [0.5, 1.1, 2.4, 4.0, 6.6, 9.4]

        render(shape("line", x1=280, y1=300, x2=280, y2=1560, color="#27405F", width=3),
               time=[19.4, 26], transition_in="wipe_down(1.0)")

        // scanner head glides with smoothstep(clamp(map_range($t))) — buttery
        render(shape("circle", radius=9, fill="#FFFFFF"),
               pos=(280, lerp(320, 1540, smooth(clamp(map_range($t, 19.8, 25.4, 0, 1), 0, 1)))),
               time=[19.8, 25.6],
               fx=[glow(color="#FFFFFF", intensity=2.4, radius=26),
                   motion_blur(samples=10, direction=90, distance=14)],
               transition_out="crossfade(0.5)")

        for i in range(6):
            my = 340 + i * 238
            bw = levels[i] * 52
            render(shape("circle", radius=11, fill=stage_color(i)), pos=(280, my),
                   time=[19.9 + i * 0.55, 26], scale=0 -> 1, ease=bounce,
                   fx=[glow(color=stage_color(i), intensity=2.1, radius=26)])
            render(shape("rect", width=bw, height=8, color=stage_color(i), radius=4),
                   pos=(304 + bw * 0.5, my), time=[20.1 + i * 0.55, 26],
                   scale=0.08 -> 1.0, ease=ease_out, opacity=0.9)
            render(text(years[i], font=mono_font, size=26, color="#9FB4D8"),
                   pos=(320 + bw, my - 34), time=[20.1 + i * 0.55, 26], transition_in="slide_up(0.5)")
            render(text(names[i], font=ui_font, size=22, color="#FFFFFF"),
                   pos=(320 + bw, my + 8), time=[20.25 + i * 0.55, 26], opacity=0 -> 1, ease=ease_in)

        // live Wikipedia knowledge card in the right column
        render(wiki("Artificial intelligence"), pos=(790, 480), time=[20.6, 26],
               scale=0 -> 0.85, ease=bounce,
               transition_in="zoom_in(0.7)",
               fx=[drop_shadow(offset_x=0, offset_y=16, blur=30, color="#000000B4"),
                   reflection(opacity=0.3, blur=6, gap=10, fade=true)])

        show_forecast = true
        if show_forecast:
            render(shape("polygon", sides=3, radius=26, fill=GOLD),
                   pos=(280, 1650), time=[23.6, 26], scale=0 -> 1, ease=bounce,
                   fx=[glow(color=GOLD, intensity=2.0, radius=30), pulse(amount=0.12, speed=2.2)])
            render(text("EXPONENTIAL AHEAD", font=mono_font, size=24, color=GOLD),
                   pos=(330, 1642), time=[23.8, 26], opacity=0 -> 1, ease=ease_out,
                   fx=[glow(color=GOLD, intensity=1.0, radius=12)])

    layer(z=8):
        render(text("70 YEARS OF SMARTER", class="section-title", anchor="center"),
               pos=(CX, 190), time=[19.6, 26],
               transition_in="slide_down(0.7)", transition_out="crossfade(0.8)")

    // ========================================================================
    // Z=6 · SCENE 5 — FINALE (25.4–32s): stacked kinetic type + halo
    // ========================================================================
    layer(z=6):
        render(shape("circle", radius=330 * peak, fill="none", stroke=CYAN, stroke_width=2),
               pos=(CX, 880), time=[25.8, 32], scale=0.4 -> 1.0, ease=ease_out,
               opacity=smooth(clamp(map_range($t, 25.8, 27.2, 0, 1), 0, 1)) * 0.8,
               fx=[glow(color=CYAN, intensity=1.4, radius=40), blend_mode("screen")])

        render(text("AI BECOMES", font=ui_font, size=48, color=ICE, anchor="center"),
               pos=(CX, 700), time=[26.0, 32], opacity=0 -> 1, ease=ease_in,
               transition_in="slide_down(0.7)")

        word = "SMARTER"
        for i in range(7):
            render(text(word[i], class="hero-title", anchor="center"),
                   pos=(CX - 402 + i * 134, 890), time=[26.4 + i * 0.13, 32],
                   scale=0.35 -> 1.0, ease=bounce,
                   fx=[glow(color=CYAN, intensity=1.6, radius=28),
                       light_sweep(angle=32, speed=0.55, width=0.2, color="#FFFFFF"),
                       vfx_preset("neon_bloom", intensity=1.15)],
                   transition_in="zoom_in(0.5)")

        render(text(agi_caption, class="chip", anchor="center"),
               pos=(CX, 1080), time=[27.6, 32], scale=0.8 -> 1.0, ease=ease_out,
               transition_in="slide_up(0.6)")

        render(text("EVERY. SINGLE. DAY.", font=cta_font, size=34, color="#9FB4D8", anchor="center"),
               pos=(CX, 1180), time=[28.2, 32], opacity=0 -> 1, ease=ease_in_out)

        render(shape("polygon", sides=4, radius=22, fill=GOLD), pos=(120, 890), time=[27.0, 32],
               scale=0 -> 1, ease=bounce,
               fx=[glow(color=GOLD, intensity=1.6, radius=20), float_y(distance=16, speed=1.1)])
        render(shape("polygon", sides=4, radius=22, fill=GOLD), pos=(960, 890), time=[27.0, 32],
               scale=0 -> 1, ease=bounce,
               fx=[glow(color=GOLD, intensity=1.6, radius=20), float_y(distance=16, speed=1.1)])

        if os.path.exists("assets/logo/logo.png"):
            render(image("assets/logo/logo.png"), pos=(90, 1760), time=[28.5, 32],
                   scale=0 -> 0.7, ease=bounce, opacity=0.9)

    // ========================================================================
    // Z=8 · CAPTIONS — voiceover-synced burn-in (one per scene)
    // ========================================================================
    layer(z=8):
        render(text("ONE NEURON. ONE SPARK.", class="caption", anchor="center"),
               pos=(CX, 1600), time=[1.4, 6.2],
               transition_in="slide_up(0.5)", transition_out="crossfade(0.5)")
        render(text("NETWORKS LEARN TO LEARN", class="caption", anchor="center"),
               pos=(CX, 1600), time=[7.0, 13.0],
               transition_in="slide_up(0.5)", transition_out="crossfade(0.5)")
        render(text("FASTER · SHARPER · SMARTER", class="caption", anchor="center"),
               pos=(CX, 1600), time=[13.8, 19.4],
               transition_in="slide_up(0.5)", transition_out="crossfade(0.5)")
        render(text("70 YEARS OF EVOLUTION", class="caption", anchor="center"),
               pos=(CX, 1600), time=[20.2, 25.9],
               transition_in="slide_up(0.5)", transition_out="crossfade(0.5)")
        render(text("EVERY. SINGLE. DAY.", class="caption", anchor="center"),
               pos=(CX, 1600), time=[27.2, 31.8],
               transition_in="slide_up(0.5)", transition_out="crossfade(0.5)")

    // ========================================================================
    // Z=9 · OPTICAL LAYER — soft scene-hit flashes, eq bars, fade, watermark
    // ========================================================================
    layer(z=9):
        render(shape("rect", width=W, height=H, color="#FFFFFF"), time=[5.4, 6.1],   opacity=0.5 -> 0.0, ease=ease_out)
        render(shape("rect", width=W, height=H, color="#FFFFFF"), time=[12.5, 13.1],  opacity=0.4 -> 0.0, ease=ease_out)
        render(shape("rect", width=W, height=H, color="#FFFFFF"), time=[19.0, 19.6],  opacity=0.4 -> 0.0, ease=ease_out)
        render(shape("rect", width=W, height=H, color="#FFFFFF"), time=[25.4, 26.3],  opacity=0.85 -> 0.0, ease=ease_out)
        render(shape("rect", width=W, height=H, color="#000000"), time=[31.2, DURATION], opacity=0 -> 1, ease=ease_in)

        // faux-audio equalizer strip pulsing under the narration
        for i in range(7):
            render(shape("rect", width=10, height=44, color=CYAN, radius=5),
                   pos=(CX - 90 + i * 30, 1740), time=[0.6, 31.6], opacity=0.55,
                   scale=0.5 + sin($t * (2.6 + (i % 3)) + i * 0.9) * 0.45,
                   fx=[blend_mode("add")])

        ticker("MOTION LANGUAGE · RENDERED IN .HMG", 1830, 2, 30)

        render(text("■ .HMG 1.2", class="watermark", anchor="center"),
               pos=(CX, 1878), time=[0, DURATION],
               opacity=clamp($frame / 120, 0, 0.8))